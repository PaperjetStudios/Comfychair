{
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@1 Picture [image]",
   "deck_keep_size": true
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "img",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "a",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ]
  },
  "_meta": {
   "title": "width"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "b",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ]
  },
  "_meta": {
   "title": "height"
  }
 },
 "pose": {
  "class_type": "DWPreprocessor",
  "inputs": {
   "image": [
    "img",
    0
   ],
   "detect_hand": "enable",
   "detect_body": "enable",
   "detect_face": "enable",
   "resolution": 512,
   "bbox_detector": "yolox_l.onnx",
   "pose_estimator": "dw-ll_ucoco_384.onnx",
   "scale_stick_for_xinsr_cn": "disable"
  }
 },
 "steady": {
  "class_type": "DeckPoseSmooth",
  "inputs": {
   "pose_keypoint": [
    "pose",
    1
   ],
   "image": [
    "pose",
    0
   ],
   "smoothing": 2.0,
   "max_gap": 6,
   "min_score": 0.3,
   "draw_hands": true,
   "draw_face": true
  },
  "_meta": {
   "title": "@12 Pose smoothing [smoothing,max_gap,min_score]"
  }
 },
 "posers": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "steady",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "bilinear",
   "keep_proportion": "stretch",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 2,
   "device": "cpu"
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "posers",
    0
   ],
   "filename_prefix": "deck/pose"
  }
 }
}
