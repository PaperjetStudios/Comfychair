{
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Source video [video]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 10.0
  },
  "_meta": {
   "title": "@2 Length (seconds) [value]"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "max(1, min(a, round(b*24)))",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ]
  },
  "_meta": {
   "title": "frames within the clip and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "det": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "rt_detr_v4-x-hgnet_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "boxes": {
  "class_type": "RTDETR_detect",
  "inputs": {
   "model": [
    "det",
    0
   ],
   "image": [
    "cut",
    0
   ],
   "threshold": 0.5,
   "class_name": "person",
   "max_detections": 1
  },
  "_meta": {
   "title": "@3 People [max_detections]"
  }
 },
 "body": {
  "class_type": "SAM3DBody_Loader",
  "inputs": {
   "model_file": "sam_3d_body_dinov3_bf16.safetensors"
  }
 },
 "pose": {
  "class_type": "SAM3DBody_Predict",
  "inputs": {
   "sam3d_body_model": [
    "body",
    0
   ],
   "image": [
    "cut",
    0
   ],
   "bboxes": [
    "boxes",
    0
   ],
   "run_hand_refinement": false,
   "fov": 0.0,
   "batch_size": 32
  }
 },
 "smooth": {
  "class_type": "SAM3DBody_Smooth",
  "inputs": {
   "mhr_pose_data": [
    "pose",
    0
   ],
   "strength": 1.0,
   "method": "gaussian",
   "window": 7,
   "rotation_threshold_degrees": 30.0
  },
  "_meta": {
   "title": "@4 Smoothing [strength,window]"
  }
 },
 "save": {
  "class_type": "DeckSaveBodyMotion",
  "inputs": {
   "mhr_pose_data": [
    "smooth",
    0
   ],
   "fps": 24.0,
   "person": 0,
   "filename_prefix": "deck/mocap"
  }
 }
}
