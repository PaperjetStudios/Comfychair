{
 "ckpt": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "ace_step_1.5_turbo_aio.safetensors"
  },
  "_meta": {
   "title": "@9 Model [ckpt_name]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 60.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "enc": {
  "class_type": "TextEncodeAceStepAudio1.5",
  "inputs": {
   "clip": [
    "ckpt",
    1
   ],
   "tags": "lo-fi hip hop, warm piano, soft drums, vinyl crackle, mellow",
   "lyrics": "",
   "seed": 0,
   "bpm": 90,
   "duration": [
    "secs",
    0
   ],
   "timesignature": "4",
   "language": "en",
   "keyscale": "C major",
   "generate_audio_codes": true,
   "cfg_scale": 2.0,
   "temperature": 0.85,
   "top_p": 0.9,
   "top_k": 0,
   "min_p": 0.0
  },
  "_meta": {
   "title": "@1 Music [tags,lyrics,bpm,keyscale,language]"
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "enc",
    0
   ]
  }
 },
 "shift": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "ckpt",
    0
   ],
   "shift": 3.0
  }
 },
 "lat": {
  "class_type": "EmptyAceStep1.5LatentAudio",
  "inputs": {
   "seconds": [
    "secs",
    0
   ],
   "batch_size": 1
  }
 },
 "run": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "shift",
    0
   ],
   "positive": [
    "enc",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "lat",
    0
   ],
   "seed": 42,
   "steps": 8,
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
  },
  "_meta": {
   "title": "@8 Seed [seed]"
  }
 },
 "dec": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "run",
    0
   ],
   "vae": [
    "ckpt",
    2
   ]
  }
 },
 "save": {
  "class_type": "SaveAudioAdvanced",
  "inputs": {
   "audio": [
    "dec",
    0
   ],
   "filename_prefix": "deck/ace-music",
   "format": "flac"
  }
 }
}
