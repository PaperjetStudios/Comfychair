{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "",
   "clip": [
    "clip",
    0
   ]
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24
  }
 },
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Source video [video]"
  }
 },
 "msk": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@5 Mask video [video]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 5.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "short": {
  "class_type": "PrimitiveInt",
  "inputs": {
   "value": 704
  },
  "_meta": {
   "title": "@4 Resolution (short side)"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((min(a, c, b*24+1, 145)-1)/8)*8+1",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ],
   "values.c": [
    "msk",
    1
   ]
  },
  "_meta": {
   "title": "frames: 8n+1 within both clips and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "mcut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "msk",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "mask": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "mcut",
    0
   ],
   "channel": "red"
  }
 },
 "sub": {
  "class_type": "DeckSubjectCrop",
  "inputs": {
   "images": [
    "cut",
    0
   ],
   "mask": [
    "mask",
    0
   ],
   "margin": 0.2,
   "short": [
    "short",
    0
   ],
   "follow": "auto",
   "smooth": 0.85
  },
  "_meta": {
   "title": "@7 Crop [margin,follow]"
  }
 },
 "lora": {
  "class_type": "LTXICLoRALoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "ltx2.5/ltx-2.5-22b-ic-lora-alpha-gen-0.9.safetensors",
   "strength_model": 1.0
  }
 },
 "vlat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "sub",
    2
   ],
   "height": [
    "sub",
    3
   ],
   "length": [
    "nf",
    1
   ],
   "batch_size": 1
  }
 },
 "guide": {
  "class_type": "LTXAddVideoICLoRAGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "vlat",
    0
   ],
   "image": [
    "sub",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "latent_downscale_factor": [
    "lora",
    1
   ],
   "crop": "disabled",
   "use_tiled_encode": false,
   "tile_size": 256,
   "tile_overlap": 64,
   "use_streaming": false,
   "tile_frames": 97
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": [
    "nf",
    1
   ],
   "frame_rate": 24,
   "batch_size": 1,
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "guide",
    2
   ],
   "audio_latent": [
    "alat",
    0
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 42
  },
  "_meta": {
   "title": "@8 Seed [noise_seed]"
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "cfg": 1.0
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "run": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "run",
    0
   ]
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  }
 },
 "vdec": {
  "class_type": "LTXVSpatioTemporalTiledVAEDecode",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "latents": [
    "crop",
    2
   ],
   "spatial_tiles": 4,
   "spatial_overlap": 1,
   "temporal_tile_length": 16,
   "temporal_overlap": 1,
   "last_frame_fix": false,
   "working_device": "auto",
   "working_dtype": "auto"
  }
 },
 "back": {
  "class_type": "DeckMatteUncrop",
  "inputs": {
   "matte": [
    "vdec",
    0
   ],
   "crop_info": [
    "sub",
    1
   ],
   "mask": [
    "mask",
    0
   ],
   "only_mask": true,
   "grow": 0.06
  },
  "_meta": {
   "title": "@8 Only the masked thing [only_mask,grow]"
  }
 },
 "vid": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "back",
    0
   ],
   "fps": 24
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/ltx-alpha-crop",
   "format": "auto",
   "codec": "auto"
  }
 }
}
