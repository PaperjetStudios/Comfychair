{
 "meshpath": {
  "class_type": "PrimitiveString",
  "inputs": {
   "value": ""
  },
  "_meta": {
   "title": "@1 Model [value]"
  }
 },
 "meshany": {
  "class_type": "LazySwitchKJ",
  "inputs": {
   "switch": true,
   "on_true": ["meshpath", 0],
   "on_false": ["meshpath", 0]
  }
 },
 "mesh": {
  "class_type": "UniRigLoadMesh",
  "inputs": {
   "source_folder": "input",
   "file_path": ["meshany", 0]
  }
 },
 "model": {
  "class_type": "UniRigLoadModel",
  "inputs": {
   "precision": "auto",
   "attn_backend": "auto"
  }
 },
 "rig": {
  "class_type": "UniRigAutoRig",
  "inputs": {
   "trimesh": ["mesh", 0],
   "model": ["model", 0],
   "skeleton_template": "articulationxl",
   "fbx_name": "",
   "target_face_count": 50000,
   "debug": false
  },
  "_meta": {
   "title": "@2 Faces [target_face_count]"
  }
 },
 "save": {
  "class_type": "DeckSaveRig",
  "inputs": {
   "rig_path": ["rig", 0],
   "filename_prefix": "deck/rig"
  }
 }
}
