{
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@1 Picture [image]",
   "deck_keep_size": true
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "img",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "a",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ]
  },
  "_meta": {
   "title": "width"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "b",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ]
  },
  "_meta": {
   "title": "height"
  }
 },
 "sdm": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "sdpose_wholebody_fp16.safetensors"
  }
 },
 "det": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "rt_detr_v4-x-hgnet_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "boxes": {
  "class_type": "RTDETR_detect",
  "inputs": {
   "model": [
    "det",
    0
   ],
   "image": [
    "img",
    0
   ],
   "threshold": 0.5,
   "class_name": "person",
   "max_detections": 2
  },
  "_meta": {
   "title": "@13 People [max_detections]"
  }
 },
 "pose": {
  "class_type": "SDPoseKeypointExtractor",
  "inputs": {
   "model": [
    "sdm",
    0
   ],
   "vae": [
    "sdm",
    2
   ],
   "image": [
    "img",
    0
   ],
   "batch_size": 16,
   "bboxes": [
    "boxes",
    0
   ]
  }
 },
 "steady": {
  "class_type": "DeckPoseSmooth",
  "inputs": {
   "pose_keypoint": [
    "pose",
    0
   ],
   "image": [
    "img",
    0
   ],
   "smoothing": 2.0,
   "max_gap": 6,
   "min_score": 0.3,
   "draw_hands": true,
   "draw_face": true
  },
  "_meta": {
   "title": "@12 Pose smoothing [smoothing,max_gap,min_score]"
  }
 },
 "posers": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "steady",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "bilinear",
   "keep_proportion": "stretch",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 2,
   "device": "cpu"
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "posers",
    0
   ],
   "filename_prefix": "deck/pose"
  }
 }
}
