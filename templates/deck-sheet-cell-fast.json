{
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@1 Picture [image]",
   "deck_keep_size": true
  }
 },
 "um": {
  "class_type": "UpscaleModelLoader",
  "inputs": {
   "model_name": "4x-UltraSharp.pth"
  }
 },
 "up4": {
  "class_type": "ImageUpscaleWithModel",
  "inputs": {
   "upscale_model": [
    "um",
    0
   ],
   "image": [
    "img",
    0
   ]
  }
 },
 "up": {
  "class_type": "ImageScaleBy",
  "inputs": {
   "image": [
    "up4",
    0
   ],
   "upscale_method": "lanczos",
   "scale_by": 0.5
  },
  "_meta": {
   "title": "@3 Enlarge [scale_by]"
  }
 },
 "model": {
  "class_type": "LoadSAM3Model",
  "inputs": {
   "precision": "auto",
   "compile": false
  }
 },
 "find": {
  "class_type": "SAM3Grounding",
  "inputs": {
   "sam3_model_config": [
    "model",
    0
   ],
   "image": [
    "up",
    0
   ],
   "confidence_threshold": 0.2,
   "text_prompt": "person",
   "max_detections": 1
  },
  "_meta": {
   "title": "@2 Cut out what [text_prompt]"
  }
 },
 "mimg": {
  "class_type": "MaskToImage",
  "inputs": {
   "mask": [
    "find",
    0
   ]
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "up",
    0
   ]
  }
 },
 "msize": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "mimg",
    0
   ],
   "upscale_method": "bilinear",
   "width": [
    "size",
    0
   ],
   "height": [
    "size",
    1
   ],
   "crop": "disabled"
  }
 },
 "mask": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "msize",
    0
   ],
   "channel": "red"
  }
 },
 "flip": {
  "class_type": "InvertMask",
  "inputs": {
   "mask": [
    "mask",
    0
   ]
  }
 },
 "join": {
  "class_type": "JoinImageWithAlpha",
  "inputs": {
   "image": [
    "up",
    0
   ],
   "alpha": [
    "flip",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "join",
    0
   ],
   "filename_prefix": "deck/sheet-cell"
  }
 }
}
