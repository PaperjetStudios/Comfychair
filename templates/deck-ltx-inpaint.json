  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((min(a, c, b*24+1)-1)/8)*8+1",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ],
   "values.c": [
    "msk",
    1
   ]
  },
  "_meta": {
   "title": "frames: 8n+1 within both clips and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
