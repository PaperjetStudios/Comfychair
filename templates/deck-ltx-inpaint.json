   "image": [
    "cut",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(a*c/min(a,b)/64)*64",
   "values.a": [
    "isize",
    0
   ],
   "values.b": [
    "isize",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "width: short side to Resolution, x64"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(b*c/min(a,b)/64)*64",
   "values.a": [
    "isize",
    0
   ],
   "values.b": [
    "isize",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "height, x64"
  }
 },
