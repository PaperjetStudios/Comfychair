{
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Source video [video]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 10.0
  },
  "_meta": {
   "title": "@2 Length (seconds) [value]"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "max(1, min(a, round(b*24)))",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ]
  },
  "_meta": {
   "title": "frames within the clip and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "vda": {
  "class_type": "LoadVideoDepthAnythingModel",
  "inputs": {
   "model": "video_depth_anything_vitl.pth"
  },
  "_meta": {
   "title": "@5 Depth model [model]"
  }
 },
 "run": {
  "class_type": "VideoDepthAnythingProcess",
  "inputs": {
   "vda_model": [
    "vda",
    0
   ],
   "images": [
    "cut",
    0
   ],
   "input_size": 448,
   "max_res": 1280,
   "precision": "fp16"
  },
  "_meta": {
   "title": "@6 Depth detail [input_size]"
  }
 },
 "grey": {
  "class_type": "VideoDepthAnythingOutput",
  "inputs": {
   "depths": [
    "run",
    0
   ],
   "colormap": "gray"
  }
 },
 "vid": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "grey",
    0
   ],
   "fps": 24
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/depth",
   "format": "auto",
   "codec": "auto"
  }
 }
}
