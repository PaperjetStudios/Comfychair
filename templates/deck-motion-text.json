{
 "llm": {"class_type": "HYMotionLoadLLM", "inputs": {"model_name": "Qwen3-8B", "quantization": "int4", "offload_to_cpu": false},
         "_meta": {"title": "Qwen3-8B text encoder, 4-bit on the GPU (~5.5 GB; was the GGUF unpacked on the CPU)"}},
 "net": {"class_type": "HYMotionLoadNetwork", "inputs": {"model_name": "HY-Motion-1.0-Lite"}},
 "enc": {"class_type": "HYMotionEncodeText", "inputs": {"llm": ["llm", 0], "text": "A person walks forward, then sits down."},
         "_meta": {"title": "@1 Motion prompt [text]"}},
 "gen": {"class_type": "HYMotionGenerate", "inputs": {"network": ["net", 0], "conditioning": ["enc", 0], "duration": 4.0, "seed": 42,
         "cfg_scale": 5.0, "num_samples": 1}, "_meta": {"title": "@2 Length (seconds) [duration,seed]"}},
 "save": {"class_type": "DeckSaveMotion", "inputs": {"motion_data": ["gen", 0], "filename_prefix": "deck/motion"}}
}
