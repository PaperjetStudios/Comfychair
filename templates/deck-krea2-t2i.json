{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "@9 Model [unet_name]" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" },
    "_meta": { "title": "Load CLIP" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "none", "strength_model": 1.0 },
    "_meta": { "title": "@3 LoRAs" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "Highly realistic detailed photograph of a lighthouse on a rocky coast at dusk, volumetric fog, warm window light", "clip": ["2", 0] },
    "_meta": { "title": "@1 Prompt" }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["5", 0] },
    "_meta": { "title": "Negative (zeroed)" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 832, "height": 1248, "batch_size": 1 },
    "_meta": { "title": "@2 Size" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0, "steps": 8, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
      "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0]
    },
    "_meta": { "title": "@4 Sampler [seed,steps,sampler_name,scheduler]" }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "comfydeck/krea2", "images": ["9", 0] },
    "_meta": { "title": "Save Image" }
  }
}
