   "type": "ltxv",
   "device": "default"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "prompt": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": "Sharp, detailed, high quality footage, natural light, fine texture."
  },
  "_meta": {
   "title": "@2 Prompt"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "prompt",
    0
   ],
   "clip": [
    "clip",
    0
   ]
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24
  }
 },
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Source video [video]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 5.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((min(a, b*24+1)-1)/8)*8+1",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ]
  },
  "_meta": {
   "title": "frames: 8n+1 within the clip and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "tiles": {
  "class_type": "LTXVGetTilingSizes",
  "inputs": {
   "image": [
    "cut",
    0
   ],
   "width": 1920,
   "height": 1080,
   "frame_count": [
    "nf",
    1
   ],
   "tile_size": "HD",
   "initial_canvas_size": "FullHD",
   "output_size": "FullHD"
  },
  "_meta": {
   "title": "@5 Output size [output_size]"
  }
 },
 "vlat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "tiles",
    4
   ],
   "height": [
    "tiles",
    5
   ],
   "length": [
    "nf",
    1
   ],
   "batch_size": 1
  }
 },
 "big": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "cut",
    0
   ],
   "upscale_method": "lanczos",
   "width": [
    "tiles",
    4
   ],
   "height": [
    "tiles",
    5
   ],
   "crop": "disabled"
  }
 },
 "lora": {
  "class_type": "LTXICLoRALoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "ltx2.5/ltx-2.5-22b-ic-lora-refine-details-1.0.safetensors",
   "strength_model": 1.0
  }
 },
 "guide": {
  "class_type": "LTXAddVideoICLoRAGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "vlat",
    0
   ],
   "image": [
    "big",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "latent_downscale_factor": [
    "lora",
    1
   ],
   "crop": "disabled",
   "use_tiled_encode": false,
   "tile_size": 256,
   "tile_overlap": 64,
   "use_streaming": true,
   "tile_frames": [
    "tiles",
    7
   ]
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "run": {
  "class_type": "LTXVTiledFusionSampler",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latents": [
    "guide",
    2
   ],
   "sigmas": [
    "sig",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "vae": [
    "vvae",
    0
   ],
   "seed": 42,
   "cfg": 1.0,
   "tile_width": [
    "tiles",
    2
   ],
   "tile_height": [
    "tiles",
    3
   ],
   "overlap_frac": [
    "tiles",
    6
   ],
   "blend_var": 0.05,
   "grid_cycle": 1,
   "tile_frames": [
    "tiles",
    7
   ],
   "canvas_device": "auto"
  },
  "_meta": {
   "title": "@8 Seed [seed]"
  }
 },
 "vdec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "run",
    0
   ],
   "vae": [
    "vvae",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
