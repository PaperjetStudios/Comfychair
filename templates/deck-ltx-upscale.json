    0
   ],
   "fps": 24
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/ltx-upscale",
   "format": "auto",
   "codec": "auto"
  }
 }
}
