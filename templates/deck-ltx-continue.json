{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "prompt": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": ""
  },
  "_meta": {
   "title": "@2 Prompt"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "prompt",
    0
   ],
   "clip": [
    "clip",
    0
   ]
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24
  }
 },
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Clip to continue [video]"
  }
 },
 "gn": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((a-1)/8)*8+1",
   "values.a": [
    "src",
    1
   ]
  },
  "_meta": {
   "title": "guide frames: the clip's 8n+1"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "gn",
    1
   ]
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 5.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "short": {
  "class_type": "PrimitiveInt",
  "inputs": {
   "value": 704
  },
  "_meta": {
   "title": "@4 Resolution (short side)"
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "cut",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(a*c/min(a,b)/32)*32",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "width: short side to Resolution, x32"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(b*c/min(a,b)/32)*32",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "height"
  }
 },
 "rs": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "cut",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "lanczos",
   "keep_proportion": "crop",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 32,
   "device": "cpu"
  }
 },
 "pre": {
  "class_type": "LTXVPreprocess",
  "inputs": {
   "image": [
    "rs",
    0
   ],
   "img_compression": 18
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((a*24+b-1)/8)*8+1",
   "values.a": [
    "secs",
    0
   ],
   "values.b": [
    "gn",
    1
   ]
  },
  "_meta": {
   "title": "frames: the guide plus Length of new footage, 8n+1"
  }
 },
 "vlat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "length": [
    "nf",
    1
   ],
   "batch_size": 1
  }
 },
 "guide": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "vlat",
    0
   ],
   "image": [
    "pre",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0
  },
  "_meta": {
   "title": "the clip's tail as the first frames"
  }
 },
 "last": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@5 End image [image]"
  }
 },
 "lastrs": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "last",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "lanczos",
   "keep_proportion": "crop",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 32,
   "device": "cpu"
  },
  "_meta": {
   "title": "end image to the video size",
   "deck_drop": true
  }
 },
 "lastpre": {
  "class_type": "LTXVPreprocess",
  "inputs": {
   "image": [
    "lastrs",
    0
   ],
   "img_compression": 18
  },
  "_meta": {
   "title": "end image preprocess",
   "deck_drop": true
  }
 },
 "endg": {
  "class_type": "LTXVAddGuide",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "guide",
    2
   ],
   "image": [
    "lastpre",
    0
   ],
   "frame_idx": -1,
   "strength": 1.0
  },
  "_meta": {
   "title": "@5 End image [strength]",
   "deck_passthrough": [
    "positive",
    "negative",
    "latent"
   ]
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": [
    "nf",
    1
   ],
   "frame_rate": 24,
   "batch_size": 1,
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "endg",
    2
   ],
   "audio_latent": [
    "alat",
    0
   ]
  }
 },
 "loras": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "@6 LoRAs"
  }
 },
 "vref": {
  "class_type": "VHS_LoadAudio",
  "inputs": {
   "audio_file": "",
   "seek_seconds": 0,
   "duration": 0
  },
  "_meta": {
   "title": "@7 Voice [audio_file]"
  }
 },
 "voice": {
  "class_type": "LTXVReferenceAudio",
  "inputs": {
   "model": [
    "loras",
    0
   ],
   "positive": [
    "endg",
    0
   ],
   "negative": [
    "endg",
    1
   ],
   "reference_audio": [
    "vref",
    0
   ],
   "audio_vae": [
    "avae",
    0
   ],
   "identity_guidance_scale": 3.0,
   "start_percent": 0.0,
   "end_percent": 1.0
  },
  "_meta": {
   "title": "@7 Voice [identity_guidance_scale]",
   "deck_passthrough": [
    "model",
    "positive",
    "negative"
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 42
  },
  "_meta": {
   "title": "@8 Seed [noise_seed]"
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "voice",
    0
   ],
   "positive": [
    "voice",
    1
   ],
   "negative": [
    "voice",
    2
   ],
   "cfg": 1.0
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "run": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "run",
    0
   ]
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "endg",
    0
   ],
   "negative": [
    "endg",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  }
 },
 "vdec": {
  "class_type": "LTXVSpatioTemporalTiledVAEDecode",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "latents": [
    "crop",
    2
   ],
   "spatial_tiles": 4,
   "spatial_overlap": 1,
   "temporal_tile_length": 16,
   "temporal_overlap": 1,
   "last_frame_fix": false,
   "working_device": "auto",
   "working_dtype": "auto"
  }
 },
 "adec": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "sep",
    1
   ],
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "vid": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "vdec",
    0
   ],
   "fps": 24,
   "audio": [
    "adec",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/ltx-continue",
   "format": "auto",
   "codec": "auto"
  }
 }
}
