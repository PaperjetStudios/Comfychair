{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "prompt": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": ""
  },
  "_meta": {
   "title": "@2 Prompt"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "prompt",
    0
   ],
   "clip": [
    "clip",
    0
   ]
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24
  }
 },
 "first": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@1 Start image [image]"
  }
 },
 "short": {
  "class_type": "PrimitiveInt",
  "inputs": {
   "value": 704
  },
  "_meta": {
   "title": "@4 Resolution (short side)"
  }
 },
 "firstsize": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "first",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(a*c/min(a,b)/32)*32",
   "values.a": [
    "firstsize",
    0
   ],
   "values.b": [
    "firstsize",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "width: short side to Resolution, x32"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(b*c/min(a,b)/32)*32",
   "values.a": [
    "firstsize",
    0
   ],
   "values.b": [
    "firstsize",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "height"
  }
 },
 "firstrs": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "first",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "lanczos",
   "keep_proportion": "crop",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 32,
   "device": "cpu"
  }
 },
 "firstpre": {
  "class_type": "LTXVPreprocess",
  "inputs": {
   "image": [
    "firstrs",
    0
   ],
   "img_compression": 18
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 5.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor(a*24/8)*8+1",
   "values.a": [
    "secs",
    0
   ]
  },
  "_meta": {
   "title": "frames: 8n+1"
  }
 },
 "vlat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "length": [
    "nf",
    1
   ],
   "batch_size": 1
  }
 },
 "i2v": {
  "class_type": "LTXVImgToVideoInplace",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "image": [
    "firstpre",
    0
   ],
   "latent": [
    "vlat",
    0
   ],
   "strength": 1.0,
   "bypass": false
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": [
    "nf",
    1
   ],
   "frame_rate": 24,
   "batch_size": 1,
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "i2v",
    0
   ],
   "audio_latent": [
    "alat",
    0
   ]
  }
 },
 "loras": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "",
   "strength_model": 1.0
  },
  "_meta": {
   "title": "@6 LoRAs"
  }
 },
 "vref": {
  "class_type": "VHS_LoadAudio",
  "inputs": {
   "audio_file": "",
   "seek_seconds": 0,
   "duration": 0
  },
  "_meta": {
   "title": "@7 Voice [audio_file]"
  }
 },
 "voice": {
  "class_type": "LTXVReferenceAudio",
  "inputs": {
   "model": [
    "loras",
    0
   ],
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "reference_audio": [
    "vref",
    0
   ],
   "audio_vae": [
    "avae",
    0
   ],
   "identity_guidance_scale": 3.0,
   "start_percent": 0.0,
   "end_percent": 1.0
  },
  "_meta": {
   "title": "@7 Voice [identity_guidance_scale]",
   "deck_passthrough": [
    "model",
    "positive",
    "negative"
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 42
  },
  "_meta": {
   "title": "@8 Seed [noise_seed]"
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "voice",
    0
   ],
   "positive": [
    "voice",
    1
   ],
   "negative": [
    "voice",
    2
   ],
   "cfg": 1.0
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "run": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "run",
    0
   ]
  }
 },
 "vdec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "sep",
    0
   ],
   "vae": [
    "vvae",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
  }
 },
 "adec": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "sep",
    1
   ],
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "vid": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "vdec",
    0
   ],
   "fps": 24,
   "audio": [
    "adec",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/ltx-i2v",
   "format": "auto",
   "codec": "auto"
  }
 }
}
