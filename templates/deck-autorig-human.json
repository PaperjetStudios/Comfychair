{
 "meshpath": {
  "class_type": "PrimitiveString",
  "inputs": {
   "value": ""
  },
  "_meta": {
   "title": "@1 Model [value]"
  }
 },
 "meshany": {
  "class_type": "LazySwitchKJ",
  "inputs": {
   "switch": true,
   "on_true": ["meshpath", 0],
   "on_false": ["meshpath", 0]
  }
 },
 "mesh": {
  "class_type": "UniRigLoadMesh",
  "inputs": {
   "source_folder": "input",
   "file_path": ["meshany", 0]
  }
 },
 "model": {
  "class_type": "MIALoadModel",
  "inputs": {
   "precision": "auto",
   "attn_backend": "auto"
  }
 },
 "rig": {
  "class_type": "MIAAutoRig",
  "inputs": {
   "trimesh": ["mesh", 0],
   "model": ["model", 0],
   "fbx_name": "",
   "no_fingers": false,
   "use_normal": false,
   "reset_to_rest": false
  },
  "_meta": {
   "title": "@2 Rig [no_fingers,reset_to_rest]"
  }
 },
 "save": {
  "class_type": "DeckSaveRig",
  "inputs": {
   "rig_path": ["rig", 0],
   "filename_prefix": "deck/rig"
  }
 }
}
