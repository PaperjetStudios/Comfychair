{
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@1 Picture [image]",
   "deck_keep_size": true
  }
 },
 "amount": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 0.4
  },
  "_meta": {
   "title": "@7 Edge amount [value]"
  }
 },
 "high": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "min(0.99, a*2)",
   "values.a": [
    "amount",
    0
   ]
  },
  "_meta": {
   "title": "the high threshold: twice the low one"
  }
 },
 "edges": {
  "class_type": "Canny",
  "inputs": {
   "image": [
    "img",
    0
   ],
   "low_threshold": [
    "amount",
    0
   ],
   "high_threshold": [
    "high",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "edges",
    0
   ],
   "filename_prefix": "deck/canny"
  }
 }
}
