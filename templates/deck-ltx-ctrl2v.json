{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
   "type": "ltxv",
   "device": "default"
  }
 },
 "vvae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "prompt": {
  "class_type": "PrimitiveStringMultiline",
  "inputs": {
   "value": ""
  },
  "_meta": {
   "title": "@2 Prompt"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "prompt",
    0
   ],
   "clip": [
    "clip",
    0
   ]
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "frame_rate": 24
  }
 },
 "src": {
  "class_type": "VHS_LoadVideoPath",
  "inputs": {
   "video": "",
   "force_rate": 24,
   "custom_width": 0,
   "custom_height": 0,
   "frame_load_cap": 0,
   "skip_first_frames": 0,
   "select_every_nth": 1
  },
  "_meta": {
   "title": "@1 Control video [video]"
  }
 },
 "secs": {
  "class_type": "PrimitiveFloat",
  "inputs": {
   "value": 5.0
  },
  "_meta": {
   "title": "@3 Length (seconds)"
  }
 },
 "nf": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "floor((min(a, b*24+1)-1)/8)*8+1",
   "values.a": [
    "src",
    1
   ],
   "values.b": [
    "secs",
    0
   ]
  },
  "_meta": {
   "title": "frames: 8n+1 within the clip and Length"
  }
 },
 "cut": {
  "class_type": "ImageFromBatch",
  "inputs": {
   "image": [
    "src",
    0
   ],
   "batch_index": 0,
   "length": [
    "nf",
    1
   ]
  }
 },
 "short": {
  "class_type": "PrimitiveInt",
  "inputs": {
   "value": 576
  },
  "_meta": {
   "title": "@4 Resolution (short side)"
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "cut",
    0
   ]
  }
 },
 "W": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(a*c/min(a,b)/64)*64",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "width: short side to Resolution, x64 (the LoRA guide is half size)"
  }
 },
 "H": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "round(b*c/min(a,b)/64)*64",
   "values.a": [
    "size",
    0
   ],
   "values.b": [
    "size",
    1
   ],
   "values.c": [
    "short",
    0
   ]
  },
  "_meta": {
   "title": "height, x64"
  }
 },
 "rs": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "cut",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "lanczos",
   "keep_proportion": "crop",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 64,
   "device": "cpu"
  }
 },
 "lora": {
  "class_type": "LTXICLoRALoaderModelOnly",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "lora_name": "ltx2.3/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors",
   "strength_model": 1.0
  }
 },
 "vlat": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "length": [
    "nf",
    1
   ],
   "batch_size": 1
  }
 },
 "img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": ""
  },
  "_meta": {
   "title": "@11 Start image [image]"
  }
 },
 "imgrs": {
  "class_type": "ImageResizeKJv2",
  "inputs": {
   "image": [
    "img",
    0
   ],
   "width": [
    "W",
    1
   ],
   "height": [
    "H",
    1
   ],
   "upscale_method": "lanczos",
   "keep_proportion": "crop",
   "pad_color": "0, 0, 0",
   "crop_position": "center",
   "divisible_by": 64,
   "device": "cpu"
  },
  "_meta": {
   "title": "start image to the video size",
   "deck_drop": true
  }
 },
 "i2v": {
  "class_type": "LTXVImgToVideoInplace",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "image": [
    "imgrs",
    0
   ],
   "latent": [
    "vlat",
    0
   ],
   "strength": 1.0,
   "bypass": false
  },
  "_meta": {
   "title": "start image (skipped when empty)",
   "deck_passthrough": "latent"
  }
 },
 "guide": {
  "class_type": "LTXAddVideoICLoRAGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vvae",
    0
   ],
   "latent": [
    "i2v",
    0
   ],
   "image": [
    "rs",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "latent_downscale_factor": [
    "lora",
    1
   ],
   "crop": "disabled",
   "use_tiled_encode": false,
   "tile_size": 256,
   "tile_overlap": 64,
   "use_streaming": false,
   "tile_frames": 97
  },
  "_meta": {
   "title": "@5 Control [strength]"
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": [
    "nf",
    1
   ],
   "frame_rate": 24,
   "batch_size": 1,
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "av": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "guide",
    2
   ],
   "audio_latent": [
    "alat",
    0
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 42
  },
  "_meta": {
   "title": "@8 Seed [noise_seed]"
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "lora",
    0
   ],
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "cfg": 1.0
  }
 },
 "ksel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler_ancestral"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "run": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "ksel",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "av",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "run",
    0
   ]
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  }
 },
 "vdec": {
  "class_type": "LTXVSpatioTemporalTiledVAEDecode",
  "inputs": {
   "vae": [
    "vvae",
    0
   ],
   "latents": [
    "crop",
    2
   ],
   "spatial_tiles": 4,
   "spatial_overlap": 1,
   "temporal_tile_length": 16,
   "temporal_overlap": 1,
   "last_frame_fix": false,
   "working_device": "auto",
   "working_dtype": "auto"
  }
 },
 "adec": {
  "class_type": "LTXVAudioVAEDecode",
  "inputs": {
   "samples": [
    "sep",
    1
   ],
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "vid": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "vdec",
    0
   ],
   "fps": 24,
   "audio": [
    "adec",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "vid",
    0
   ],
   "filename_prefix": "deck/ltx-ctrl2v",
   "format": "auto",
   "codec": "auto"
  }
 }
}
